{
  "name": "genshin-chrome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "description": "A programmable Electron browser shell for debugging web applications.",
  "main": "src/main.ts",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "bun run dev",
    "dev": "./dev.sh",
    "build": "vite build",
    "build:app": "bun run build && electron-builder --mac",
    "install:app": "./install.ts",
    "preview": "electron .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run format:check && bun run test:smoke",
    "test:smoke": "bun run build && playwright test tests/smoke.spec.ts --workers=1"
  },
  "dependencies": {
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "wait-on": "9.1.0"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "vue-demi"
  ]
}
