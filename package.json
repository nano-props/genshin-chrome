{
  "name": "genshin-chrome",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "A programmable Electron browser shell for debugging web applications.",
  "main": "src/main.js",
  "scripts": {
    "start": "bun run dev",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"bun run dev:electron\"",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build",
    "preview": "electron .",
    "test:smoke": "bun run build && playwright test tests/smoke.spec.js --workers=1"
  },
  "dependencies": {
    "reka-ui": "^2.6.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-vue-jsx": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^38.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "wait-on": "^8.0.0"
  },
  "trustedDependencies": [
    "electron",
    "esbuild",
    "vue-demi"
  ]
}
